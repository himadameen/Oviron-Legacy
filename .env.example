# Production canonical URL (required for SEO, Open Graph, sitemap, and campaign landing consistency)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Contact channels — leave empty until verified
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# Optional campaign media (full-width banner)
NEXT_PUBLIC_BANNER_VIDEO_URL=
NEXT_PUBLIC_BANNER_POSTER=

# Remote Unsplash images (default: local SVG placeholders in /public/images)
# NEXT_PUBLIC_USE_REMOTE_IMAGES=true

# Local dev: npm run dev clears cache and uses Turbopack by default
# NEXT_DISABLE_TURBOPACK=1
